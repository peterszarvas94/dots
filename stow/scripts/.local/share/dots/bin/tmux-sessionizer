#!/usr/bin/env bash

# Based on ThePrimeagen's tmux-sessionizer

# Select dirs
parent_dirs=(~/Work ~/Projects ~/src/tries ~/.config/omarchy/plugins)

select_directory() {
    for parent_dir in "${parent_dirs[@]}"; do
        [[ -d $parent_dir ]] || continue
        # Include parent directories themselves
        printf '%s\n' "$parent_dir"
        # Include visible children of parent directories
        find "$parent_dir" -maxdepth 1 -mindepth 1 -type d ! -name go ! -name '.*'
    done
}

path="${1:-$(select_directory | fzf --prompt='Select a directory: ')}"

[[ -z $path ]] && exit 0
path=$(realpath -e -- "$path") || exit 1
[[ -d $path ]] || exit 1

# Convert the directory name to a tmux-safe session name
session_name=$(basename "$path" | tr . _ | sed 's/[^[:alnum:]_-]/_/g')

# A basename is readable, but it is not unique. Do not attach to an old
# session for a different project with the same directory name.
if tmux has-session -t="$session_name" 2>/dev/null; then
    existing_path=$(tmux display-message -p -t "$session_name" '#{session_path}')
    if [[ $existing_path != "$path" ]]; then
        path_hash=$(printf '%s' "$path" | sha256sum | cut -c1-8)
        session_name="${session_name}_${path_hash}"
    fi
fi

if [[ -z ${TMUX:-} ]] || ! tmux display-message -p >/dev/null 2>&1; then
    # Not attached to a live tmux client.
    tmux new-session -A -s "$session_name" -c "$path"
else
    if ! tmux has-session -t="$session_name" 2>/dev/null; then
        tmux new-session -d -s "$session_name" -c "$path"
    fi
    # Let tmux resolve the client running this command. Explicitly targeting a
    # captured /dev/pts path can switch a different client in multi-window use.
    tmux switch-client -t "$session_name"
fi
