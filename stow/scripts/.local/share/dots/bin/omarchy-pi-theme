#!/usr/bin/env python3
"""Generate a pi TUI theme from the current Omarchy colors.toml."""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

import tomllib

SCHEMA = (
    "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/"
    "modes/interactive/theme/theme-schema.json"
)
PI_THEME_NAME = "omarchy-colors"
PI_THEMES_DIR = Path.home() / ".pi" / "agent" / "themes"
PI_SETTINGS = Path.home() / ".pi" / "agent" / "settings.json"
OMARCHY_CURRENT = Path.home() / ".config" / "omarchy" / "current" / "theme" / "colors.toml"
STALE_THEMES = (
    "omarchy-light.json",
    "omarchy-dark.json",
    "rosepine.json",
    "rosepine-dawn.json",
)


def hex_to_rgb(color: str) -> tuple[int, int, int]:
    color = color.strip().removeprefix("#")
    return int(color[0:2], 16), int(color[2:4], 16), int(color[4:6], 16)


def rgb_to_hex(rgb: tuple[int, int, int]) -> str:
    return "#" + "".join(f"{channel:02x}" for channel in rgb)


def relative_luminance(color: str) -> float:
    channels = []
    for value in hex_to_rgb(color):
        channel = value / 255
        channels.append(channel / 12.92 if channel <= 0.03928 else ((channel + 0.055) / 1.055) ** 2.4)
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]


def is_dark(background: str) -> bool:
    return relative_luminance(background) < 0.5


def blend(color_a: str, color_b: str, ratio: float) -> str:
    rgb_a = hex_to_rgb(color_a)
    rgb_b = hex_to_rgb(color_b)
    mixed = tuple(
        round(rgb_a[index] + (rgb_b[index] - rgb_a[index]) * ratio) for index in range(3)
    )
    return rgb_to_hex(mixed)


def adjust(color: str, amount: float) -> str:
    rgb = hex_to_rgb(color)
    if amount >= 0:
        adjusted = tuple(round(channel + (255 - channel) * amount) for channel in rgb)
    else:
        adjusted = tuple(round(channel * (1 + amount)) for channel in rgb)
    return rgb_to_hex(adjusted)


def load_colors(path: Path) -> dict[str, str]:
    with path.open("rb") as handle:
        data = tomllib.load(handle)
    colors: dict[str, str] = {}
    for key, value in data.items():
        if isinstance(value, str) and value.startswith("#"):
            colors[key] = value.lower()
    return colors


def pick(colors: dict[str, str], *keys: str, fallback: str = "#888888") -> str:
    for key in keys:
        value = colors.get(key)
        if value:
            return value
    return fallback


def build_theme(colors: dict[str, str]) -> dict[str, Any]:
    background = pick(colors, "background")
    foreground = pick(colors, "foreground")
    color0 = pick(colors, "color0", "selection_background")
    overlay = color0
    muted = pick(colors, "color8", "color7")
    subtle = blend(muted, foreground, 0.42 if is_dark(background) else 0.45)
    dark = is_dark(background)

    if dark:
        surface = blend(background, overlay, 0.15)
        highlight_low = adjust(background, 0.03)
        highlight_med = blend(overlay, muted, 0.35)
        highlight_high = blend(highlight_med, muted, 0.35)
        tool_pending = adjust(background, -0.04)
        tool_success = blend(background, pick(colors, "color2", "color10"), 0.18)
        tool_error = blend(background, pick(colors, "color1", "color9"), 0.18)
    else:
        surface = blend(background, "#ffffff", 0.45)
        highlight_low = blend(background, "#ffffff", 0.25)
        highlight_med = pick(colors, "selection_background", "color0")
        highlight_high = blend(highlight_med, muted, 0.35)
        tool_pending = blend(background, overlay, 0.35)
        tool_success = blend(background, pick(colors, "color2", "color10"), 0.12)
        tool_error = blend(background, pick(colors, "color1", "color9"), 0.12)

    red = pick(colors, "color1", "color9")
    green = pick(colors, "color2", "color10")
    yellow = pick(colors, "color3", "color11")
    blue = pick(colors, "color4", "color12", "accent")
    magenta = pick(colors, "color5", "color13")
    cyan = pick(colors, "color6", "color14")

    vars_map = {
        "base": background,
        "surface": surface,
        "overlay": overlay,
        "muted": muted,
        "subtle": subtle,
        "text": foreground,
        "love": red,
        "gold": yellow,
        "rose": cyan,
        "pine": green,
        "foam": blue,
        "iris": magenta,
        "highlightLow": highlight_low,
        "highlightMed": highlight_med,
        "highlightHigh": highlight_high,
        "toolPendingBg": tool_pending,
        "toolSuccessBg": tool_success,
        "toolErrorBg": tool_error,
    }

    return {
        "$schema": SCHEMA,
        "name": PI_THEME_NAME,
        "vars": vars_map,
        "colors": {
            "accent": "iris",
            "border": "pine",
            "borderAccent": "foam",
            "borderMuted": "highlightMed",
            "success": "foam",
            "error": "love",
            "warning": "gold",
            "muted": "subtle",
            "dim": "muted",
            "text": "",
            "thinkingText": "subtle",
            "selectedBg": "highlightMed",
            "userMessageBg": "surface",
            "userMessageText": "",
            "customMessageBg": "overlay",
            "customMessageText": "",
            "customMessageLabel": "iris",
            "toolPendingBg": "toolPendingBg",
            "toolSuccessBg": "toolSuccessBg",
            "toolErrorBg": "toolErrorBg",
            "toolTitle": "foam" if dark else "pine",
            "toolOutput": "subtle",
            "mdHeading": "gold",
            "mdLink": "foam" if dark else "pine",
            "mdLinkUrl": "muted",
            "mdCode": "iris",
            "mdCodeBlock": "foam" if dark else "pine",
            "mdCodeBlockBorder": "highlightHigh",
            "mdQuote": "subtle",
            "mdQuoteBorder": "muted",
            "mdHr": "muted",
            "mdListBullet": "foam",
            "toolDiffAdded": "foam",
            "toolDiffRemoved": "love",
            "toolDiffContext": "subtle",
            "syntaxComment": "muted",
            "syntaxKeyword": "pine",
            "syntaxFunction": "love",
            "syntaxVariable": "rose",
            "syntaxString": "gold",
            "syntaxNumber": "rose",
            "syntaxType": "foam",
            "syntaxOperator": "subtle",
            "syntaxPunctuation": "subtle",
            "thinkingOff": "overlay",
            "thinkingMinimal": "muted",
            "thinkingLow": "pine",
            "thinkingMedium": "foam",
            "thinkingHigh": "iris",
            "thinkingXhigh": "love",
            "thinkingMax": "love",
            "bashMode": "gold",
        },
        "export": {
            "pageBg": "base",
            "cardBg": "surface",
            "infoBg": "overlay",
        },
    }


def update_settings() -> None:
    if not PI_SETTINGS.is_file():
        return
    settings = json.loads(PI_SETTINGS.read_text(encoding="utf-8"))
    if settings.get("theme") == PI_THEME_NAME:
        return
    settings["theme"] = PI_THEME_NAME
    PI_SETTINGS.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")


def remove_stale_themes() -> None:
    for filename in STALE_THEMES:
        stale = PI_THEMES_DIR / filename
        if stale.is_file():
            stale.unlink()


def main() -> int:
    if not OMARCHY_CURRENT.is_file():
        return 1

    theme = build_theme(load_colors(OMARCHY_CURRENT))
    output = PI_THEMES_DIR / f"{PI_THEME_NAME}.json"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(theme, indent=2) + "\n", encoding="utf-8")

    remove_stale_themes()
    update_settings()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
