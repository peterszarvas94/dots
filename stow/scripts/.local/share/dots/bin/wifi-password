#!/usr/bin/env bash

set -euo pipefail

if ! command -v fzf >/dev/null 2>&1; then
    printf 'fzf is not installed or not on PATH\n' >&2
    exit 1
fi

case "$(uname -s)" in
    Linux)
        if ! command -v nmcli >/dev/null 2>&1; then
            printf 'nmcli is required on Linux (NetworkManager)\n' >&2
            exit 1
        fi

        networks=$(nmcli -t -f NAME,TYPE connection show | awk '/:802-11-wireless$/ { sub(/:802-11-wireless$/, ""); print }')
        selected=$(printf '%s\n' "$networks" | fzf --prompt='Select saved Wi-Fi network: ' || true)
        [[ -n "$selected" ]] || exit 0

        password=$(nmcli -g 802-11-wireless-security.psk connection show "$selected" 2>/dev/null || true)
        if [[ -z "$password" || "$password" == "--" ]]; then
            printf 'No saved password for %s\n' "$selected" >&2
            exit 1
        fi
        printf '%s\n' "$password"
        ;;
    Darwin)
        if ! command -v networksetup >/dev/null 2>&1 || ! command -v security >/dev/null 2>&1; then
            printf 'networksetup and security are required on macOS\n' >&2
            exit 1
        fi

        wifi_device=$(networksetup -listallhardwareports | awk '/^Hardware Port: (Wi-Fi|AirPort)$/ { getline; print $2; exit }')
        if [[ -z "$wifi_device" ]]; then
            printf 'Could not find a macOS Wi-Fi interface\n' >&2
            exit 1
        fi

        networks=$(networksetup -listpreferredwirelessnetworks "$wifi_device" | awk 'NR > 1 { sub(/^[[:space:]]+/, ""); if ($0 != "") print }')
        selected=$(printf '%s\n' "$networks" | fzf --prompt='Select saved Wi-Fi network: ' || true)
        [[ -n "$selected" ]] || exit 0

        if ! password=$(security find-generic-password -D 'AirPort network password' -a "$selected" -w 2>/dev/null); then
            if ! password=$(security find-generic-password -a "$selected" -w 2>/dev/null); then
                printf 'Could not read the saved password for %s from Keychain\n' "$selected" >&2
                exit 1
            fi
        fi
        printf '%s\n' "$password"
        ;;
    *)
        printf 'Unsupported operating system: %s\n' "$(uname -s)" >&2
        exit 1
        ;;
esac
