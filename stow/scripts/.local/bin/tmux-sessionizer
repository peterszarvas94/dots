#!/usr/bin/env bash

# Based on ThePrimeagen's tmux-sessionizer

# Select dirs
parent_dirs=(~/Work ~/Projects ~/src/tries)

select_directory() {
    # Include parent directories themselves
    printf '%s\n' "${parent_dirs[@]}"
    # Include children of parent directories
    find "${parent_dirs[@]}" -maxdepth 1 -mindepth 1 -type d ! -name go
}

# Capture before fzf takes over the tty
client_tty=$(tmux display-message -p '#{client_tty}' 2>/dev/null)

path="${1:-$(select_directory | fzf --prompt='Select a directory: ')}"

[[ -z $path ]] && exit 0

# Convert the directory name to a tmux-safe session name
session_name=$(basename "$path" | tr . _)

if [[ -z $client_tty ]]; then
    # Not attached to a tmux client (even if $TMUX is set)
    tmux new-session -A -s "$session_name" -c "$path"
else
    if ! tmux has-session -t="$session_name" 2>/dev/null; then
        tmux new-session -d -s "$session_name" -c "$path"
    fi
    tmux switch-client -c "$client_tty" -t "$session_name"
fi
