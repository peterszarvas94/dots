# Optional: only included when Colima has generated it (Mac/Linux).
Include ~/.config/colima/ssh_config*

# Safe defaults. No keys are selected globally.
Host *
  AddKeysToAgent yes
  IdentitiesOnly yes
  ForwardAgent no

# configure which keys used for which machine
Host some_machine
  HostName some_machine
  User peti
  IdentitiesOnly yes
  IdentityFile ~/.ssh/some_key_to_access_some_machine

# GitHub uses user "git", not "peti"
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github
  IdentityAgent none
  IdentitiesOnly yes
  ForwardAgent no
