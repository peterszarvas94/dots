# Optional: only included when Colima has generated it (Mac/Linux).
Include ~/.config/colima/ssh_config*

Host asimov
  HostName asimov
  User peti
  IdentityFile ~/.ssh/minivac_to_asimov
  IdentitiesOnly yes

# Global defaults: file keys + ssh-agent (see ~/.agents/skills/dots/doc/ssh.md)
Host *
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github
  IdentityFile ~/.ssh/hetzner
  IdentityFile ~/.ssh/linode
  IdentityFile ~/.ssh/bandcash
  IdentityFile ~/.ssh/coolify
  IdentityFile ~/.ssh/scaleway
